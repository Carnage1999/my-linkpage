# Password for the /manage dashboard. Click recording stays off until this
# and the Upstash variables are all set.
STATS_PASSWORD=

# IANA timezone for dashboard day boundaries. Defaults to Asia/Taipei.
STATS_TIMEZONE=Asia/Taipei

# Upstash Redis REST credentials.
# Console → your database → REST API → UPSTASH_REDIS_REST_URL and UPSTASH_REDIS_REST_TOKEN.
# https://console.upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Umami. Use the same website id as public/siteConfig.json (umamiWebsiteId).
# Cloud API key: Umami Cloud → Settings → API keys. Leave UMAMI_API_URL empty
# to call https://api.umami.is.
# Self-hosted API key: set UMAMI_API_URL to the Umami origin and UMAMI_API_KEY.
# Self-hosted login: set UMAMI_API_URL plus UMAMI_USERNAME and UMAMI_PASSWORD
# instead of an API key. The token stays on the server.
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=
