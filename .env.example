# Password for the /manage dashboard. Click recording and pageviews stay off
# until this and the Upstash variables are all set. It is also the encryption
# key for secrets saved on /manage, unless STATS_SECRET is set.
STATS_PASSWORD=

# Optional dedicated key for secrets saved on /manage. Changing STATS_SECRET
# or STATS_PASSWORD (when it is the key) makes those secrets unreadable.
STATS_SECRET=

# IANA timezone for dashboard day boundaries. Overrides the value saved on
# /manage. Defaults to Asia/Taipei.
STATS_TIMEZONE=Asia/Taipei

# Upstash Redis REST credentials. Required to persist /manage and to record
# clicks and pageviews.
# Console → your database → REST API.
# https://upstash.com/docs/redis/features/restapi
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Any of the provider variables below override the same field saved on /manage.
# Leave them empty to edit that field in the dashboard.

# Umami. https://docs.umami.is/docs/api
# Cloud API key uses https://api.umami.is/v1 and header x-umami-api-key.
# The tracker script is https://cloud.umami.is/script.js, not the API host.
# Self-hosted login uses UMAMI_API_URL plus UMAMI_USERNAME and UMAMI_PASSWORD.
UMAMI_API_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=
UMAMI_USERNAME=
UMAMI_PASSWORD=

# GoatCounter. https://www.goatcounter.com/help/api
# GOATCOUNTER_SITE is the site code or https://code.goatcounter.com.
GOATCOUNTER_SITE=
GOATCOUNTER_API_KEY=

# Cloudflare Web Analytics GraphQL. The token needs Account Analytics Read.
# https://developers.cloudflare.com/analytics/graphql-api/
# CLOUDFLARE_WA_SITE_TAG is the public beacon token.
# https://developers.cloudflare.com/web-analytics/
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_WA_SITE_TAG=
